           self.commands_receiver.try_recv().unwrap_or(Command::NoOp)
         }
       } else {
@@ -331,7 +341,10 @@ impl<P: ProxyToSamplesBuffer> FlowsTransmitterInternal<P> {
             if let Some(now) = self.now() {
               self.transmit(&mut dither_rng, now, true);
             } else {
