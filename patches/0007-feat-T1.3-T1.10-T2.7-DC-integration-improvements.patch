     };
@@ -281,7 +285,10 @@ impl<P: ProxyToSamplesBuffer> FlowsTransmitterInternal<P> {
       let now = if let Some(now) = self.now() {
         now
       } else {
-        error!("clock unavailable, can't transmit. is the PTP daemon running? (@get now)");
