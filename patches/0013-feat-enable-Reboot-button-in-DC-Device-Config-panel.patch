From eb2788fc415d6bb85583c47c739fff7fcff2a276 Mon Sep 17 00:00:00 2001
From: Jelle Jassies <jellejassies@outlook.com>
Date: Mon, 6 Apr 2026 18:45:25 +0000
Subject: [PATCH] feat: enable Reboot button in DC Device Config panel
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Set feature flag bit 0x40 in board_info response byte 0x17. DC uses this
flag to determine whether the Reboot button is enabled. Factory reset (0x80)
is intentionally left unset — we don't support factory reset.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 inferno_aoip/src/device_server/info_mcast_server.rs | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/inferno_aoip/src/device_server/info_mcast_server.rs b/inferno_aoip/src/device_server/info_mcast_server.rs
index 058edf5..0066805 100644
--- a/inferno_aoip/src/device_server/info_mcast_server.rs
+++ b/inferno_aoip/src/device_server/info_mcast_server.rs
@@ -143,12 +143,12 @@ impl<'s> Multicaster<'s> {
     // 0x17: feature flags:
     //   0x08 = Identify device (LED blink)
     //   0x10 = Sample rate & encoding (enables DC to query/display these values)
-    //   0x40 = Reboot (omitted — not implemented)
-    //   0x80 = Factory reset (omitted — not implemented)
+    //   0x40 = Reboot (enables the Reboot button in DC Device Config panel)
+    //   0x80 = Factory reset (intentionally omitted — we don't implement factory reset)
     content[0x14] = 0;
     content[0x15] = 0;
     content[0x16] = 0x10;
-    content[0x17] = 0x08; // Identify only — bit 0x10 would make DC show rate/encoding as editable
+    content[0x17] = 0x08 | 0x40; // Identify + Reboot; 0x80 (factory reset) intentionally excluded
 
     content[0xbb] = 0x1f; // if 0, device is flooded with info multicast requests around 1 per second
     content[0xbf] = 5;   // T1.6: limit DC polling rate for board-info sub-types (matches reference capture)
-- 
