From 81d378ef25b740f3e280649599038bd01023ae33 Mon Sep 17 00:00:00 2001
From: Jelle Jassies <jellejassies@outlook.com>
Date: Mon, 6 Apr 2026 06:25:52 +0000
Subject: [PATCH] feat(T2.1): audio peak levels (0x8002) in DC heartbeat
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add 0x8002 block to the Packet 1 heartbeat (alongside 0x8000+0x8001).

Format reverse-engineered from live Dante device (192.168.1.43) capture
with audio actively flowing:
  [u16 block_len][u16 0x8002][u16 0x0004][u16 data_len][u32 counter]
  [u16 num_tx_ch][u16 num_rx_ch][u32 reserved]
  [u16 bits_per_sample][u16 reserved]
  [u8 × num_tx_ch peak values][u8 × num_rx_ch peak values][pad if odd]

get_peaks() was already wired in Multicaster but never called.
Now called once per heartbeat to populate the block. Peaks are 0-255
log-scale (peaks.rs: 0=silence, 255=0dBFS) per channel.

Verified on dante-doos with active audio: TX peaks vary 71-84/255,
RX peaks vary 165-173/255 as expected for live audio. DC's per-channel
peak meters should now show levels.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 .../src/device_server/info_mcast_server.rs    | 32 +++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/inferno_aoip/src/device_server/info_mcast_server.rs b/inferno_aoip/src/device_server/info_mcast_server.rs
index b575c2f..a8d41fb 100644
--- a/inferno_aoip/src/device_server/info_mcast_server.rs
+++ b/inferno_aoip/src/device_server/info_mcast_server.rs
@@ -206,6 +206,9 @@ impl<'s> Multicaster<'s> {
       // Shure MXWANI8 sends both every second as two separate UDP datagrams.
       // Each group has its own block seqnum counter (independent of the packet seqnum).
       {
+        // T2.1: get audio peaks before building the buffer (requires &mut self)
+        let (tx_peaks, rx_peaks) = (self.get_peaks)();
+
         let ctr = self.util_block_seqnum;
         let mut bytes = ByteBuffer::new();
         bytes.set_endian(bytebuffer::Endian::BigEndian);
@@ -233,6 +236,35 @@ impl<'s> Multicaster<'s> {
         bytes.write_u16(0);
         bytes.write_i32(freq_offset);
 
+        // T2.1: 0x8002 audio peak levels per channel
+        // Format (from Dante device capture): [num_tx u16][num_rx u16][reserved u32]
+        //   [bits_per_sample u16][reserved u16][tx peaks u8...][rx peaks u8...][pad if odd]
+        {
+          let num_tx = tx_peaks.len() as u16;
+          let num_rx = rx_peaks.len() as u16;
+          let peak_bytes = tx_peaks.len() + rx_peaks.len();
+          let padded_peak_bytes = (peak_bytes + 1) & !1; // round up to even boundary
+          let data_len = (12 + padded_peak_bytes) as u16;
+          let block_len = 12 + data_len;
+          bytes.write_u16(block_len);
+          bytes.write_u16(0x8002);
+          bytes.write_u16(4);
+          bytes.write_u16(data_len);
+          bytes.write_u16(ctr);
+          bytes.write_u16(0);
+          bytes.write_u16(num_tx);
+          bytes.write_u16(num_rx);
+          bytes.write_u32(0); // reserved
+          bytes.write_u16(self.self_info.bits_per_sample as u16);
+          bytes.write_u16(0); // reserved
+          for &p in tx_peaks.iter().chain(rx_peaks.iter()) {
+            bytes.write_u8(p);
+          }
+          if peak_bytes & 1 != 0 {
+            bytes.write_u8(0); // alignment padding
+          }
+        }
+
         self.util_block_seqnum = self.util_block_seqnum.wrapping_add(1);
         let content = bytes.as_bytes().to_vec();
         self.send(self.heartbeat_destination, 0xfffe, [0, 8, 0, 1, 0x10, 0, 0, 0], &content).await;
-- 
